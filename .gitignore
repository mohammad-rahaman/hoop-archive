# ───────────── Hoop Archive ─────────────

# ---- Secrets / env ----
.env
*.env
!*.env.example
backend/.env

# ---- Datasets (do NOT commit third-party / Kaggle data; license unverified) ----
backend/data/raw/
backend/data/*.csv
!backend/data/sample/*.csv

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Flutter / Dart ----
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/.idea/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/android/.gradle/
mobile/android/local.properties
mobile/*.iml
**/generated/
*.g.dart.lock

# ---- OS / editor ----
.DS_Store
.vscode/*
!.vscode/settings.json
*.log
