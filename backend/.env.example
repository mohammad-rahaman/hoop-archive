# Hoop Archive backend configuration — copy to `.env` and fill in.
# NEVER commit a real .env. The Sportradar key must stay server-side only.

# App
ENVIRONMENT=development

# Database (SQLAlchemy URL). The default below uses libpq peer auth via the
# local unix socket as the current OS user. For an explicit TCP connection use:
#   postgresql+psycopg2://USER:PASSWORD@localhost:5432/hoop_archive
DATABASE_URL=postgresql+psycopg2:///hoop_archive

# Sportradar NBA API (trial = internal evaluation only; do not redistribute data)
# Leave blank to run the backend with historical/sample data only.
SPORTRADAR_API_KEY=
SPORTRADAR_BASE_URL=https://api.sportradar.com/nba/trial/v8/en

# Pagination
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
