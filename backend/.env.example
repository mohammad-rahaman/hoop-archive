# Hoop Archive backend configuration — copy to `.env` and fill in.
# NEVER commit a real .env. The Sportradar key must stay server-side only.

# App
ENVIRONMENT=development

# Database (SQLAlchemy URL). The default below uses libpq peer auth via the
# local unix socket as the current OS user. For an explicit TCP connection use:
#   postgresql+psycopg2://USER:PASSWORD@localhost:5432/hoop_archive
DATABASE_URL=postgresql+psycopg2:///hoop_archive

# Sportradar NBA API (trial = internal evaluation only; do not redistribute data)
# Leave blank to run the backend with historical/sample data only.
SPORTRADAR_API_KEY=
SPORTRADAR_BASE_URL=https://api.sportradar.com/nba/trial/v8/en
# Label only (trial|production) — used for provenance, not for auth.
SPORTRADAR_ACCESS_LEVEL=trial
SPORTRADAR_TIMEOUT_SECONDS=15

# Scheduled sync (off by default). A background refresh runs ONLY when a key is
# set, SYNC_ENABLED=true, and both a season year and team ids are configured.
SYNC_ENABLED=false
SYNC_INTERVAL_HOURS=24
# Season start year to refresh, e.g. 2024 for the 2024-25 season.
SYNC_SEASON_YEAR=
# Comma-separated Sportradar team ids to refresh (never guessed).
#   e.g. sr:team:3410,sr:team:3415
SYNC_TEAM_IDS=
# Optional shared secret required by POST /sync/sportradar (recommended in prod).
SYNC_ADMIN_TOKEN=

# Pagination
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# Connection pool & scaling (sized PER WORKER). Under Gunicorn the total
# connections to Postgres is workers * (DB_POOL_SIZE + DB_MAX_OVERFLOW) and must
# stay under the server's max_connections. See backend/gunicorn_conf.py.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# Seconds a request waits for a free connection before failing fast (load-shed).
DB_POOL_TIMEOUT=10
# Postgres statement timeout (ms); cancels a runaway query. 0 disables.
DB_STATEMENT_TIMEOUT_MS=15000
# Gunicorn worker count. Unset = derived from DB_CONNECTION_BUDGET and CPU count.
# WEB_CONCURRENCY=4
# Upper bound on total DB connections across all workers (keeps under max_connections).
DB_CONNECTION_BUDGET=80
